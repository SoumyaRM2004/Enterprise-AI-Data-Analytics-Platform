# Django
SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://analytics_user:analytics_pass@localhost:5432/analytics_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# LLM Provider (options: openai, gemini, ollama, openai_compatible)
LLM_PROVIDER=openai_compatible
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your-openai-key
OPENAI_API_BASE=https://api.openai.com/v1
GEMINI_API_KEY=your-gemini-key
OLLAMA_BASE_URL=http://localhost:11434

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@analytics-platform.com

# Sentry (optional)
# SENTRY_DSN=https://your-sentry-dsn
